# ============================================
# Salon Booking API — Environment Template
# Copy this file to .env and update values:
#   cp .env.example .env
# ============================================

# Application
PROJECT_NAME="Salon Booking API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
# development | staging | production
ENVIRONMENT=development
DEBUG=True

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=salon_user
POSTGRES_PASSWORD=superuser
POSTGRES_DB=salon_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Security & JWT
# IMPORTANT: Generate a unique value with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Never deploy production with the placeholder value below.
SECRET_KEY=change_this_to_a_very_secret_and_long_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_PER_MINUTE=1440

# Login Brute-force Protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# CORS — production တွင် real frontend domain များကိုသာ ထည့်ပါ (* မထည့်ပါနှင့်)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:5173
# ALLOWED_HOSTS — production တွင် real domain များကိုသာ ထည့်ပါ
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,10.0.2.2

# Proxy — API သည် trusted reverse-proxy / load balancer နောက်မှသာ True ထားပါ
TRUST_PROXY_HEADERS=False

# Optional error tracking
# SENTRY_DSN=https://public_key@ingest.sentry.io/project_id
