                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{base_url}}",
                "api",
                "v1",
                "auth",
                "logout"
              ]
            }
          },
          "description": "Current access token ကို Redis blacklist ထဲ revoke လုပ်သည်။ Logout ပြီးရင် Me ကို ပြန်ခေါ်ကြည့်ပါ → 401.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ],
      "description": "Run order: Login → Me → Refresh → Logout. Login တိုင်း token အသစ်များ auto-save ဖြစ်သည်။"
    },
